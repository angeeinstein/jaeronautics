SECRET_KEY=change-me
LANGUAGES=en

DB_HOST=127.0.0.1
DB_NAME=jaeronautics
DB_USER=jaeronautics
DB_PASSWORD=change-me
DB_PORT=3306

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_PRICE_ID=price_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
MEMBERSHIP_TIMEZONE=Europe/Vienna
PUBLIC_BASE_URL=https://members.example.com
# Footer links. The Impressum and privacy notice default to the website, the
# statutes to the portal's own legal page, until their own addresses are set.
ASSOCIATION_WEBSITE_URL=https://joanneum-aeronautics.at
IMPRESSUM_URL=
PRIVACY_URL=
STATUTES_URL=
CONTACT_EMAIL=office@joanneum-aeronautics.at
# Optional comma-separated hostnames for additional trusted entrypoints.
ADDITIONAL_ALLOWED_HOSTS=
# Upper request-size guardrail. Avatar-specific limits are enforced separately in the app.
MAX_CONTENT_LENGTH=20971520

RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
# Each form that takes a password or an address has two limits: one per email
# address from one network (stops password guessing) and one per network
# (stops floods; a lecture hall on one campus address shares it).
RATELIMIT_LOGIN=10 per 15 minute
RATELIMIT_LOGIN_PER_IP=300 per 15 minute
RATELIMIT_REGISTER=5 per hour
RATELIMIT_REGISTER_PER_IP=300 per hour
RATELIMIT_MEMBERSHIP=10 per 15 minute
RATELIMIT_MEMBERSHIP_PER_IP=300 per hour
RATELIMIT_PASSWORD_CHANGE=5 per 15 minute
RATELIMIT_ADMIN_EMAIL=5 per 10 minute

# MAIL_ACCOUNTS_JSON is an optional fallback for SMTP sender accounts.
# The preferred path is managing sender accounts in the admin UI.
MAIL_ACCOUNTS_JSON='{"office":{"host":"smtp.example.com","port":465,"user":"office@example.com","pass":"change-me"},"noreply":{"host":"smtp.example.com","port":587,"user":"noreply@example.com","pass":"change-me","starttls":true}}'
# Log retention (days). 0 = keep forever. Audit logs are kept forever by default;
# higher-churn notification delivery records are pruned after a year.
AUDIT_LOG_RETENTION_DAYS=0
NOTIFICATION_RETENTION_DAYS=365
