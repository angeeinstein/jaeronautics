  "info": {
    "title": "Joanneum Aeronautics member portal",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/accounts": {
      "get": {
        "operationId": "admin_accounts",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "default": "",
              "description": "Name, address or forum username; part of one is enough.",
              "maxLength": 200,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "membership",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "all",
                "active",
                "ending",
                "pending",
                "failed",
                "ended",
                "none"
              ],
              "title": "Membership",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "default": "all",
              "description": "\"all\", \"staff\" (any admin role), \"none\" (no role) or a role's slug.",
              "title": "Role",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "account",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "all",
                "active",
                "no_sign_in",
                "disabled",
                "erased"
              ],
              "title": "Account",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "default": "all",
              "description": "\"archived\": carried over from the old forum and not reconnected yet.",
              "enum": [
                "all",
                "portal",
                "archived"
              ],
              "title": "Kind",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "name",
              "enum": [
                "name",
                "kind",
                "membership",
                "until",
                "forum"
              ],
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "dir",
            "required": false,
            "schema": {
              "default": "asc",
              "enum": [
                "asc",
                "desc"
              ],
              "title": "Dir",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountListOut"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The input is not valid (see error.fields)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not signed in."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Signed in, without the permission."
          }
        },
        "summary": "One page of the account list, with how many each membership filter would show.",
        "tags": [
          "Admin"
        ],
        "x-permissions": [
          "accounts.view"
        ]
      }
    },
    "/api/v1/admin/dashboard": {
      "get": {
        "operationId": "admin_dashboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Not signed in."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Signed in, without the permission."
          }
        },
        "summary": "What needs doing, the membership in four figures, and the latest log entries.",
        "tags": [
          "Admin"
        ],
        "x-permissions": [
          "admin.access"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me",
